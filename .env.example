# mainnet-beta | devnet
NEXT_PUBLIC_CLUSTER=mainnet-beta
# Use an RPC that allows getProgramAccounts (Helius / Triton free tier works). Public RPCs block it.
NEXT_PUBLIC_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Your platform wallet: receives the partner share of fees and indexes all launches
NEXT_PUBLIC_PLATFORM_FEE_CLAIMER=YOUR_WALLET_PUBKEY
# Public URL of the deployment (used for token metadata URIs)
NEXT_PUBLIC_SITE_URL=https://bellcurve-launch.vercel.app
# Devnet only: printed by `pnpm devnet:e2e`
NEXT_PUBLIC_DEVNET_MOCK_STOCK_MINT=
